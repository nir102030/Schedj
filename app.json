{
  "expo": {
    "name": "Schedj",
    "slug": "Schedj",
    "privacy": "public",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schedj.app"
    },
    "android": {
      "package": "com.schedj.app"
    },
    "web": {
      "bundler": "metro"
    },
    "description": "",
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ]
  }
}
